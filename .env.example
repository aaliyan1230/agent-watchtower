# API keys for live model calls. Copy to .env and fill in; .env is
# gitignored. The harness runs fully offline without these.
# Gemini models (workers, Gemini judge) go through the Gemini API.
GEMINI_API_KEY=

# Every other judge family (DeepSeek, Kimi) goes through OpenRouter.
OPENROUTER_API_KEY=

# Models (mid-tier price/performance as of Nov 2026, per 1M tokens),
# each judge at its minimum reasoning level:
#   workers:        gemini-3.5-flash-lite              $0.30 in / $2.50 out  (low)
#   Gemini judge:   gemini-3.8-flash                   $0.83 in / $4.12 out  (low)
#   DeepSeek judge: deepseek/deepseek-v4.1-flash-1017  $0.30 in / $1.20 out  (off)
#   Kimi judge:     moonshotai/kimi-k3                 $0.19 in / $15.00 out (off)
# Set per slot in code/config; the defaults above are used when unset.
# Optional override for tests or alternate endpoints.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional: Bedrock judge credentials. When key+secret are set here,
# the experiment server uses them directly; otherwise the AWS CLI
# session is forwarded (aws configure export-credentials).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
