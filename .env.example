# API keys for live model calls. Copy to .env and fill in; .env is
# gitignored. The harness runs fully offline without these.
# Every live target (workers and judges) goes through OpenRouter.
OPENROUTER_API_KEY=

# Optional: call Gemini directly instead (judge backend "gemini").
GEMINI_API_KEY=

# Models (price/performance as of Aug 2026, per 1M tokens):
#   workers (bulk, agentic): google/gemini-3.5-flash-lite  $0.30 in / $2.50 out
#   judge (capped calls):    google/gemini-3.6-flash       $0.75 in / $3.75 out
# Set per slot in code/config; the defaults above are used when unset.
# Optional override for tests or alternate endpoints.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional: Bedrock judge credentials. When key+secret are set here,
# the experiment server uses them directly; otherwise the AWS CLI
# session is forwarded (aws configure export-credentials).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
