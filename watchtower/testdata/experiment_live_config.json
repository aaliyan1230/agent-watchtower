{
  "contracts": [
    {
      "name": "ticket",
      "fields": {
        "id": { "required": true, "type": "int" },
        "title": { "required": true, "type": "string" },
        "labels": { "required": false, "type": "array" }
      }
    }
  ],
  "policy": { "allowedTools": ["search"] },
  "loop": { "enabled": true },
  "limits": { "maxSteps": 8, "maxTotalTokens": 1500, "maxDurationMs": 60000 },
  "evidence": {
    "enabled": true,
    "obligations": {
      "requireRoot": true,
      "requireAgentCompletion": true,
      "requireModelCorrelation": true,
      "requireToolResults": true,
      "requireFinalAnswer": true,
      "requireSupervisorDecision": true,
      "requireTemporalNesting": true,
      "requireTraceClosed": true
    }
  },
  "judge": { "enabled": true, "backend": "openrouter", "model": "google/gemini-3.6-flash" }
}
